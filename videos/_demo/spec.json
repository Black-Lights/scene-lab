            "dashed": true
          }
        ],
        "groups": [
          {
            "label": "The server's machine",
            "nodes": [
              "p443",
              "p80",
              "web"
            ]
          }
        ]
      }
    },
    {
      "heading": "Faster too",
      "say": "Newer versions are faster, too. TLS one point two needs two round trips before your data can flow. TLS one point three needs just one. And a resumed connection can send data right away.",
      "visual": {
        "type": "chart",
        "title": "Round trips before data flows",
        "items": [
          {
            "label": "TLS 1.2",
            "value": 2,
            "cue": "two"
          },
          {
            "label": "TLS 1.3",
            "value": 1,
            "cue": "just"
          },
          {
            "label": "TLS 1.3, resumed",
            "value": 0,
            "cue": "resumed"
          }
        ]
      }
    },
    {
      "heading": "A short history",
      "say": "The lock has been evolving for about thirty years. SSL arrived in nineteen ninety-five. TLS replaced it in ninety-nine. Version one point two came in two thousand eight, and one point three in twenty eighteen.",
      "visual": {
        "type": "timeline",
        "items": [
          {
            "when": "1995",
            "label": "SSL 2.0, the first public version",
            "cue": "SSL"
          },
          {
            "when": "1999",
            "label": "TLS 1.0 replaces SSL",
            "cue": "replaced"
          },
          {
            "when": "2008",
            "label": "TLS 1.2",
            "cue": "came"
          },
          {
            "when": "2018",
            "label": "TLS 1.3, faster and simpler",
            "cue": "twenty"
          }
        ]
      }
    },
    {
      "heading": "The catch",
      "say": "And this is what someone snooping on the network actually sees. A tiny header that says, encrypted data follows, and then bytes that look like pure noise.",
      "visual": {
        "type": "code",
        "title": "What an eavesdropper sees",
        "cue": "header",
        "highlight": [
          1
        ],
        "code": "17 03 03 00 4a\n9f 2c e1 07 b4 5d 0a 73 c8 31\n6e f2 0b 99 a4 1d 58 e3 07 bc\n2a 91 d4 66 0f 3b c2 8e 75 19"
      }
    },
    {
      "say": "So the lock is a promise about the connection. But here is the catch.",
      "visual": {
        "type": "image",
        "image": {
          "q": "padlock",
          "provider": "wikimedia",
          "pick": 2
        },
        "caption": "A real padlock, the object the browser's lock icon stands for"
      }
    },
    {
      "say": "The lock means the line is private. It does not mean the site is honest. A scam site can have a perfectly valid certificate too.",
      "visual": {
        "type": "definition",
        "icon": "warning",
        "term": "What the lock means",
        "text": "A private line to this site, whoever runs it."
      }
    },
    {
      "heading": "Recap",
      "say": "So, three things to remember. The secret key is never sent, it is mixed. The certificate proves who you are talking to. And the lock protects the line, not the truth.",
      "visual": {
        "type": "recap",
        "title": "Remember",
        "items": [
          {
            "swatch": "brown",
            "text": "The key is mixed on each side, never sent",
            "cue": "secret"
          },
          {
            "icon": "id-card",
            "text": "The certificate proves who is talking",
            "cue": "certificate"
          },
          {
            "icon": "lock",
            "text": "The lock protects the connection only",
            "cue": "lock"
          }
        ]
      }
    }
  ]
}