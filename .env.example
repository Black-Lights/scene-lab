# Asset source keys. Copy this file to .env (gitignored) and fill in only the keys you have.
# A missing key means that source is skipped quietly (a request that names the source says which key it needs);
# the eleven keyless sources (docs/asset-sources.md lists them) always work.
# Never paste a key into a chat. make.py reads .env and never prints a key.

# Pixabay: photos, illustrations, vectors, video clips. https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Unsplash: photos. https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# The Noun Project: professional icons (key and secret). https://thenounproject.com/developers/
NOUN_PROJECT_KEY=
NOUN_PROJECT_SECRET=

# Freesound: sound effects. https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# Jamendo: music under Creative Commons licences. https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=

# NASA APIs such as APOD (the NASA image library itself needs no key). https://api.nasa.gov/
NASA_API_KEY=

# Smithsonian Open Access, CC0 science and museum images (an api.data.gov key). https://api.data.gov/signup/
SMITHSONIAN_API_KEY=

# Europeana: cultural heritage images. https://pro.europeana.eu/page/get-api
EUROPEANA_API_KEY=

# Sketchfab: downloadable 3D models (API token from your account settings). https://sketchfab.com/
SKETCHFAB_API_TOKEN=

# Openverse works without credentials; these only raise its rate limit.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
