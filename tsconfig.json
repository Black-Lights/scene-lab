{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@kit": [
        "src/kit/index.ts"
      ],
      "@kit/*": [
        "src/kit/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
